# ==== Discord ====
DISCORD_TOKEN=isi_token_bot_discord_kamu
CLIENT_ID=isi_application_id_bot
# Opsional: isi jika mau deploy slash command hanya ke 1 server (instan, untuk testing).
# Kosongkan untuk deploy global (butuh ~1 jam propagasi ke semua server).
GUILD_ID=

# ==== Roblox ====
# Group ID komunitas MANTRA CREATIVE (dari link https://www.roblox.com/id/communities/783602348/MANTRA-CREATIVE)
ROBLOX_GROUP_ID=783602348

# API Key dari https://create.roblox.com/dashboard/credentials
# Pastikan API System diaktifkan untuk group MANTRA CREATIVE dengan permission:
#   - Group API -> group:read (dan legacy group scope jika diminta saat membuat key)
ROBLOX_API_KEY=isi_api_key_roblox_kamu

# ==== Aturan Eligibility ====
# Minimal hari bergabung di grup Roblox supaya dianggap eligible
ELIGIBILITY_DAYS=14

# Warna embed (hex tanpa #), boleh dikosongkan untuk pakai default di src/config.js
EMBED_COLOR_ELIGIBLE=2ECC71
EMBED_COLOR_PENDING=F1C40F
EMBED_COLOR_NOT_MEMBER=E74C3C

# Nama & URL komunitas (untuk footer/author embed)
COMMUNITY_NAME=MANTRA CREATIVE
COMMUNITY_URL=https://www.roblox.com/id/communities/783602348/MANTRA-CREATIVE

# ==== Quiz Arena Leaderboard ====
# Role yang otomatis dipasang ke Top 1/2/3 leaderboard. Kosongkan untuk pakai
# default yang sudah di-set di src/config.js.
QUIZ_ROLE_TOP1=1553133641587105942
QUIZ_ROLE_TOP2=1553133806456930435
QUIZ_ROLE_TOP3=1553133866460647485

# ==== Server Booster Thank You ====
# Channel tempat pesan + gambar "Terima kasih boost" dikirim (klik kanan channel -> Copy Channel ID)
BOOST_CHANNEL_ID=isi_channel_id_boost_kamu

# ==== Music / Voice 24/7 ====
# Voice channel yang bot otomatis join & tetap "nempel" di situ 24/7 begitu online.
# Kosongkan kalau mau kontrol manual lewat /musicjoin (join ke voice channel invoker).
MUSIC_VOICE_CHANNEL_ID=isi_id_voice_channel_kamu
# Channel teks default tempat panel kontrol musik dipasang (opsional, cuma dipakai
# sebagai referensi -- panel-nya sendiri dipasang lewat command /musicpanel di
# channel manapun kamu jalankan command itu).
MUSIC_PANEL_CHANNEL_ID=
